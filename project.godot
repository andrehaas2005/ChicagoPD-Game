; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ChicagoPD"
config/description="Jogo de investigação policial ambientado em Chicago"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

CaseManager="*res://scripts/core/case_manager.gd"
CharacterRegistry="*res://scripts/core/character_registry.gd"
GameState="*res://scripts/core/game_state.gd"
GameClock="*res://scripts/core/game_clock.gd"
CaseState="*res://scripts/core/case_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/tema_arquivo.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
